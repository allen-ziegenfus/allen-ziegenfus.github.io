---
import einstellungen from "../../../public/site.json";
import Layout from "../../layouts/Layout.astro";
import Bildbetrachter from "../../components/ImageViewer.jsx";
import { Eigenschaft, EigenschaftMitLink } from "../../components/Eigenschaft";
import werkgruppen from "../../../public/werkgruppen.json";
import SuchNavigation from "../../components/SearchNavigation";

export async function getStaticPaths() {
  const werke = [];
  for (const werkgruppe of werkgruppen) {
    for (const eintrag of werkgruppe.Records) {
      werke.push({
        workSlug: eintrag.Slug,
        slug: werkgruppe.Slug,
        titel: werkgruppe.Titel,
        werk: eintrag,
      });
    }
  }
  return werke.map((w, index, alle) => ({
    params: {
      slug: w.slug,
      workSlug: w.workSlug,
    },
    props: {
      werk: w.werk,
      slug: w.slug,
      workSlug: w.workSlug,
      titel: w.titel,
      vorher:
        index > 0
          ? `/${alle[index - 1].slug}/${alle[index - 1].workSlug}`
          : false,
      nachher:
        index < alle.length - 1
          ? `/${alle[index + 1].slug}/${alle[index + 1].workSlug}`
          : false,
    },
  }));
}
const { werk, slug, workSlug, titel, nachher, vorher } = Astro.props;
---

<Layout
  titel={werk.Titel + " - " + einstellungen.websiteTitel}
  beschreibung={werk.Beschreibung}
  bild={werk.Bilder[0].video ? werk.Thumbnail : werk.Bilder[0].src}
>
  <SuchNavigation client:only />
  <nav class="print:hidden">
    <ul class="flex flex-row flex-wrap">
      <li><a class="text-blue-800" href="/">Startseite</a>&nbsp; / &nbsp;</li>
      <li>
        <a class="text-blue-800" href={`/${slug}`}> {titel}</a>&nbsp; / &nbsp;
      </li>
      <li>
        <a class="text-blue-800" href={`/${slug}/${workSlug}`}>{werk.InvNr}</a>
      </li>
    </ul>
  </nav>

  <h2 class="md:hidden text-lg md:text-2xl py-3">{werk.Titel}</h2>
  <main class="flex flex-col-reverse lg:flex-row print:flex-row">
    <div class="eigenschaften w-full lg:w-1/2">
      <h2 class="hidden md:block text-lg md:text-2xl py-3">{werk.Titel}</h2>
      <h2 class="py-3 text-xl">Inv. Nr.: {werk.InvNr}</h2>
      <h3 class="py-3 text-xl">Eigenschaften</h3>
      <EigenschaftMitLink
        titel="Werkgruppe"
        href={`/${slug}`}
        wert={werk.Werkgruppe}
      />
      <Eigenschaft titel="Jahr" wert={werk.Jahr} />
      <Eigenschaft titel="Maße" wert={werk.Maße} />
      <Eigenschaft titel="Anzahl" wert={werk.Anzahl} />
      <Eigenschaft titel="Signatur" wert={werk.Signatur} />
      <Eigenschaft titel="Zustand" wert={werk.Zustand} />
      <Eigenschaft titel="Beschreibung" wert={werk.Beschreibung} />
      <Eigenschaft titel="Standort" wert={werk.Standort} />
      <Eigenschaft titel="Technik" wert={werk.Technik} />
      <Eigenschaft titel="Auflage" wert={werk.Auflage} />
      <Eigenschaft titel="Foto" wert={werk.Foto} />
      <Eigenschaft titel="Ausstellung" wert={werk.Ausstellung} />
      <Eigenschaft titel="Literatur" wert={werk.Literatur} />
      <Eigenschaft titel="Bibliographie" wert={werk.Bibliographie} />
    </div>
    <div class="lg:ml-2 w-full lg:w-1/2">
      <div class="m-2 flex flex-row text-4xl justify-around">
        {
          vorher && (
            <a class="print:hidden text-gray-500" href={vorher}>
              {" "}
              &lt;
            </a>
          )
        }
        {
          nachher && (
            <a class="print:hidden text-gray-500" href={nachher}>
              {" "}
              &gt;
            </a>
          )
        }
      </div>
      <Bildbetrachter client:load bilder={werk.Bilder} titel={werk.Titel} />
    </div>
  </main>
</Layout>
