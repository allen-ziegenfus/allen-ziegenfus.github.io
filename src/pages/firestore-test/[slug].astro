---
/**
 * One Werkgruppe rendered from Firestore instead of werkgruppen.json, to compare
 * with /<slug>/. Only built when FIRESTORE_PROJECT is set.
 */
import Card from "../../components/Card.astro";
import Layout from "../../layouts/Layout.astro";
import { db, artist } from "../../werkverzeichnis/firestore";

export async function getStaticPaths() {
  if (!db) return [];
  const groups = await artist().collection("werkgruppen").get();
  return Promise.all(groups.docs.map(async (g) => {
    const works = await artist().collection("works").where("werkgruppe", "==", g.id).get();
    const records = works.docs.map(d => ({ slug: d.id, ...d.data() }))
      .sort((a: any, b: any) =>
        Number(a.InvNr.replace(/\D/g, "")) - Number(b.InvNr.replace(/\D/g, "")));
    return { params: { slug: g.id }, props: { group: g.data(), records } };
  }));
}

const { group, records } = Astro.props;
const isVideo = (p: string) => p.endsWith(".webm") || p.endsWith(".mp4");
const thumb = (w: any) => w.images?.[0] && !isVideo(w.images[0]) ? w.images[0] : "/placeholder.png";
---

<Layout title={group.titel + " (Firestore) - " + import.meta.env.WEBSITE_TITLE} noindex>
  <main>
    <p class="bg-yellow-100 p-2 my-2 text-sm">
      Test: aus Firestore gebaut ({records.length} Werke). Vergleich:
      <a class="text-blue-800" href={`/${Astro.params.slug}`}>/{Astro.params.slug}</a>
    </p>
    <h2 class="text-lg md:text-2xl py-3">{group.titel}</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {records.map((w: any) => (
        <Card href={`/${Astro.params.slug}/${w.slug}`} title={w.InvNr} body={w.Titel} thumbnail={thumb(w)} />
      ))}
    </div>
  </main>
</Layout>
