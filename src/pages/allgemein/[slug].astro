---
import site from "../../../public/site.json";
import Layout from "../../layouts/Layout.astro";
import pages from "../../../public/pages.json";

export async function getStaticPaths() {

  return pages.map((page) => ({
    params: {
      slug: page.Slug,
    },
    props: { page },
  }));
}
const { page } = Astro.props;

---

<Layout title={page.Name + ' - ' + site.websiteTitel}>
  <style is:global>
    .page-text p {
      text-indent: 1.5em;
    }
    .page-text h3, .page-text p {
      margin-bottom: 1em;
    }
    /* Tables (Biografie): two columns like the old grid, narrow first column. */
    .page-text table {
      width: 100%;
    }
    .page-text td {
      padding: 0.25rem 0.5rem 0.25rem 0;
      vertical-align: top;
    }
    .page-text td:first-child {
      width: 33%;
      white-space: nowrap;
    }
    @media (min-width: 768px) {
      .page-text td:first-child {
        width: 16.666%;
      }
    }
    /* Markdown tables always have a header row; ours are left empty. */
    .page-text thead:not(:has(th:not(:empty))) {
      display: none;
    }
  </style>
  <main class="my-4">
    <nav class="print:hidden">
      <ul class="flex flex-row">
        <li><a class="text-blue-800" href="/">Startseite</a>&nbsp; / &nbsp;</li>
        <li>
          <a class="text-blue-800" href={`/allgemein/${page.Slug}`}> {page.Name}</a>
        </li>
      </ul>
    </nav>
    <h2 class="text-lg md:text-2xl py-3">{page.Name}</h2> 
    <div class="page-text my-2" set:html={page.Html}></div>
  </main>
</Layout>
