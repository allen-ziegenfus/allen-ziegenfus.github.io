---
/**
 * Ein Bild aus den Build-Daten (build_data.ts → Bild): ein <picture> mit
 * AVIF- und WebP-srcsets, wenn die Bildfunktion sie erzeugt hat, sonst ein
 * schlichtes <img>. `sizes` sagt dem Browser, wie breit das Bild angezeigt wird,
 * damit er eine Breite wählen kann. Die winzige unscharfe Vorschau füllt den
 * Platz, bis das Bild geladen ist.
 */
export interface Props {
  bild: {
    src: string; breite?: number; hoehe?: number;
    avif?: string; webp?: string; vorschau?: string;
  };
  alt: string;
  sizes?: string;
  class?: string;
  sofort?: boolean;
}
const { bild, alt, sizes = "100vw", class: klasse, sofort = false } = Astro.props;
const stil = bild.vorschau ? `background: url(${bild.vorschau}) center / cover no-repeat` : undefined;
---

{bild.webp ? (
  <picture>
    {bild.avif && <source type="image/avif" srcset={bild.avif} sizes={sizes} />}
    <source type="image/webp" srcset={bild.webp} sizes={sizes} />
    <img src={bild.src} alt={alt} width={bild.breite} height={bild.hoehe} class={klasse}
         style={stil} loading={sofort ? "eager" : "lazy"} decoding="async" />
  </picture>
) : (
  <img src={bild.src} alt={alt} class={klasse} loading={sofort ? "eager" : "lazy"} decoding="async" />
)}
