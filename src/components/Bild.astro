---
/**
 * One image from the build data (build_data.ts → Bild): a <picture> with AVIF
 * and WebP srcsets when the image function made them, a plain <img> otherwise.
 * `sizes` tells the browser how wide the image is shown, so it can pick a width.
 * The tiny blurred preview fills the space until the image has loaded.
 */
export interface Props {
  bild: {
    src: string; breite?: number; hoehe?: number;
    avif?: string; webp?: string; vorschau?: string;
  };
  alt: string;
  sizes?: string;
  class?: string;
  eager?: boolean;
}
const { bild, alt, sizes = "100vw", class: className, eager = false } = Astro.props;
const style = bild.vorschau ? `background: url(${bild.vorschau}) center / cover no-repeat` : undefined;
---

{bild.webp ? (
  <picture>
    {bild.avif && <source type="image/avif" srcset={bild.avif} sizes={sizes} />}
    <source type="image/webp" srcset={bild.webp} sizes={sizes} />
    <img src={bild.src} alt={alt} width={bild.breite} height={bild.hoehe} class={className}
         style={style} loading={eager ? "eager" : "lazy"} decoding="async" />
  </picture>
) : (
  <img src={bild.src} alt={alt} class={className} loading={eager ? "eager" : "lazy"} decoding="async" />
)}
