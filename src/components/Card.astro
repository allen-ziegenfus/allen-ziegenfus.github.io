---
import Bild from "./Bild.astro";
export interface Props {
  titel: string;
  text: string;
  href: string;
  bild: { src: string; [key: string]: unknown };
}

const { href, titel, text, bild } = Astro.props;
---

<li class="list-none border-2 rounded-lg p-3 text-center hover:border-gray-600">
  <a class="flex flex-col" href={href}>

    <!-- Das Raster: 1 Spalte auf Telefonen, 2 ab md, 4 ab lg. -->
    <Bild bild={bild} alt={titel} sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw" />
    <h2 class="pt-2">
      {titel}
    </h2>
    <p>
      {text}
    </p>
  </a>
</li>
