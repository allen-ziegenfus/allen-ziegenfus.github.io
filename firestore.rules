rules_version = '2';

// Firestore test (FIRESTORE.md). The build reads with a service account, which
// bypasses these rules; they govern the browser editor and admin page only.
//
// Roles follow Firebase's role-based access pattern
// (firebase.google.com/docs/firestore/solutions/role-based-access):
//
//   who has which role   data: artists/{artist}.roles = { email: role }
//   what a role may do   code: permissions() below, and nowhere else
//
// Rules ask can(artist, permission), never for a role. Super-admins are a custom
// claim (tools/super_admin.mjs) and may do everything. The same table is in
// src/werkverzeichnis/permissions.js for the UI; tools/rules_test.mjs checks
// every role × permission, so the two copies cannot drift apart.
service cloud.firestore {
  match /databases/{database}/documents {

    function permissions() {
      return {
        "admin":  ["read", "works.edit", "werkgruppen.edit", "seiten.edit", "settings.edit", "roles.manage"],
        "editor": ["read", "works.edit"]
      };
    }

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.get("superAdmin", false) == true;
    }

    function roleOf(artist) {
      return get(/databases/$(database)/documents/artists/$(artist)).data.roles.get(email(), "");
    }

    function can(artist, permission) {
      return isSuperAdmin()
        || (signedIn() && permission in permissions().get(roleOf(artist), []));
    }

    function validArtist(d) {
      return d.keys().hasOnly(["titel", "websiteTitel", "titelZeile1", "titelZeile2",
                               "copyright", "roles", "active", "updatedAt"])
        && d.titel is string && d.titel.size() > 0
        && d.websiteTitel is string && d.titelZeile1 is string
        && d.titelZeile2 is string && d.copyright is string
        && d.roles is map && d.roles.size() <= 50
        && d.roles.values().hasOnly(permissions().keys())
        && d.active is bool
        && d.updatedAt == request.time;
    }

    match /artists/{artist} {
      allow get: if can(artist, "read");
      // Super-admins list all; everyone else queries for their own email in roles.
      allow list: if isSuperAdmin()
        || (signedIn() && resource.data.roles[email()] in permissions().keys());

      // The id becomes the site's ARTIST_ID and a Pages project name.
      allow create: if isSuperAdmin()
        && artist.matches("^[a-z0-9][a-z0-9-]{1,39}$")
        && validArtist(request.resource.data);

      // Settings and roles are separate permissions, so a write needs whichever
      // of the two it touches.
      allow update: if validArtist(request.resource.data)
        && (can(artist, "settings.edit")
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["roles", "updatedAt"]))
        && (can(artist, "roles.manage")
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["roles"]));

      // Deactivate instead: deleting the document would orphan its subcollections.
      allow delete: if false;
    }

    function validWerkgruppe(d) {
      return d.keys().hasOnly(["titel", "kurztitel", "reihenfolge", "cover"])
        && d.titel is string && d.titel.size() > 0
        && (d.get("kurztitel", null) == null || d.kurztitel is string)
        && d.reihenfolge is int
        && (d.get("cover", null) == null || d.cover is string);
    }

    match /artists/{artist}/werkgruppen/{werkgruppe} {
      allow read: if can(artist, "read");
      allow create: if can(artist, "werkgruppen.edit")
        && werkgruppe.matches("^[a-z0-9][a-z0-9-]{0,59}$")
        && validWerkgruppe(request.resource.data);
      allow update: if can(artist, "werkgruppen.edit") && validWerkgruppe(request.resource.data);
      // Not yet: its works would be left without a Werkgruppe.
      allow delete: if false;
    }

    function validSeite(d) {
      return d.keys().hasOnly(["titel", "kategorie", "reihenfolge", "text", "updatedAt"])
        && d.titel is string && d.titel.size() > 0 && d.titel.size() <= 100
        && d.kategorie in ["Header", "Footer"]
        && d.reihenfolge is int
        && d.text is string && d.text.size() <= 200000
        && d.updatedAt == request.time;
    }

    // Content pages (Einführung, Impressum, …): Markdown, edited in the admin page.
    match /artists/{artist}/seiten/{seite} {
      allow read: if can(artist, "read");
      allow create: if can(artist, "seiten.edit")
        && seite.matches("^[a-z0-9][a-z0-9-]{0,59}$")
        && validSeite(request.resource.data);
      allow update: if can(artist, "seiten.edit") && validSeite(request.resource.data);
      allow delete: if can(artist, "seiten.edit");
    }

    match /artists/{artist}/works/{work} {
      allow read: if can(artist, "read");

      // Edit only (no create/delete in the test). The Inv. Nr. and Werkgruppe
      // are fixed, the timestamp is the server's, and the same write must add the
      // history entry that `lastChange` points to — so no edit goes unrecorded.
      allow update: if can(artist, "works.edit")
        && request.resource.data.InvNr == resource.data.InvNr
        && request.resource.data.werkgruppe == resource.data.werkgruppe
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/artists/$(artist)/history/$(request.resource.data.lastChange)).data.work == work
        && !exists(/databases/$(database)/documents/artists/$(artist)/history/$(request.resource.data.lastChange));
    }

    // Append-only change log: who, when, which work. Never edited or deleted.
    match /artists/{artist}/history/{entry} {
      allow read: if can(artist, "read");
      allow create: if can(artist, "works.edit")
        && request.resource.data.by == email()
        && request.resource.data.at == request.time
        && request.resource.data.work is string
        && request.resource.data.changes is map;
    }
  }
}
