rules_version = '2';

// Der Build liest mit einem Servicekonto, für das diese Regeln nicht gelten; sie
// regeln nur den Editor und die Verwaltungsseite im Browser.
//
// Die Rollen folgen Firebases Muster für rollenbasierten Zugriff
// (firebase.google.com/docs/firestore/solutions/role-based-access):
//
//   wer welche Rolle hat    Daten: artists/{artist}.roles = { E-Mail: Rolle }
//   was eine Rolle darf     Code: berechtigungen() unten, und nirgends sonst
//
// Die Regeln fragen darf(kuenstler, berechtigung), nie nach einer Rolle.
// Super-Admins sind ein Custom Claim (tools/super_admin.mjs) und dürfen alles.
// Dieselbe Tabelle steht für die Oberfläche in src/werkverzeichnis/permissions.js;
// tools/rules_test.mjs prüft jede Rolle × Berechtigung, damit die beiden Kopien
// nicht auseinanderlaufen.
service cloud.firestore {
  match /databases/{database}/documents {

    function berechtigungen() {
      return {
        "admin":  ["lesen", "werke.bearbeiten", "werkgruppen.bearbeiten", "seiten.bearbeiten",
                   "einstellungen.bearbeiten", "rollen.verwalten", "veroeffentlichen"],
        "editor": ["lesen", "werke.bearbeiten"]
      };
    }

    function angemeldet() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function emailAdresse() {
      return request.auth.token.email;
    }

    function istSuperAdmin() {
      return angemeldet() && request.auth.token.get("superAdmin", false) == true;
    }

    function rolleVon(kuenstler) {
      return get(/databases/$(database)/documents/artists/$(kuenstler)).data.roles.get(emailAdresse(), "");
    }

    function darf(kuenstler, berechtigung) {
      return istSuperAdmin()
        || (angemeldet() && berechtigung in berechtigungen().get(rolleVon(kuenstler), []));
    }

    function gueltigerKuenstler(d) {
      return d.keys().hasOnly(["titel", "websiteTitel", "titelZeile1", "titelZeile2",
                               "copyright", "roles", "active", "updatedAt"])
        && d.titel is string && d.titel.size() > 0
        && d.websiteTitel is string && d.titelZeile1 is string
        && d.titelZeile2 is string && d.copyright is string
        && d.roles is map && d.roles.size() <= 50
        && d.roles.values().hasOnly(berechtigungen().keys())
        && d.active is bool
        && d.updatedAt == request.time;
    }

    match /artists/{kuenstler} {
      allow get: if darf(kuenstler, "lesen");
      // Super-Admins listen alle; alle anderen fragen nach ihrer E-Mail in roles.
      allow list: if istSuperAdmin()
        || (angemeldet() && resource.data.roles[emailAdresse()] in berechtigungen().keys());

      // Die Kennung wird zur ARTIST_ID der Seite und zum Namen eines Pages-Projekts.
      allow create: if istSuperAdmin()
        && kuenstler.matches("^[a-z0-9][a-z0-9-]{1,39}$")
        && gueltigerKuenstler(request.resource.data);

      // Einstellungen und Rollen sind getrennte Berechtigungen; ein Schreibvorgang
      // braucht die, deren Felder er ändert.
      allow update: if gueltigerKuenstler(request.resource.data)
        && (darf(kuenstler, "einstellungen.bearbeiten")
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["roles", "updatedAt"]))
        && (darf(kuenstler, "rollen.verwalten")
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["roles"]));

      // Stattdessen deaktivieren: Löschen würde die Untersammlungen verwaisen lassen.
      allow delete: if false;
    }

    function gueltigeWerkgruppe(d) {
      // cover: Pfad des Titelbilds in Cloud Storage.
      return d.keys().hasOnly(["titel", "kurztitel", "reihenfolge", "cover"])
        && d.titel is string && d.titel.size() > 0
        && (d.get("kurztitel", null) == null || d.kurztitel is string)
        && d.reihenfolge is int
        && (d.get("cover", null) == null || d.cover is string);
    }

    match /artists/{kuenstler}/werkgruppen/{werkgruppe} {
      allow read: if darf(kuenstler, "lesen");
      allow create: if darf(kuenstler, "werkgruppen.bearbeiten")
        && werkgruppe.matches("^[a-z0-9][a-z0-9-]{0,59}$")
        && gueltigeWerkgruppe(request.resource.data);
      allow update: if darf(kuenstler, "werkgruppen.bearbeiten") && gueltigeWerkgruppe(request.resource.data);
      // Noch nicht: Ihre Werke stünden ohne Werkgruppe da.
      allow delete: if false;
    }

    function gueltigeSeite(d) {
      return d.keys().hasOnly(["titel", "kategorie", "reihenfolge", "text", "updatedAt"])
        && d.titel is string && d.titel.size() > 0 && d.titel.size() <= 100
        && d.kategorie in ["Header", "Footer"]
        && d.reihenfolge is int
        && d.text is string && d.text.size() <= 200000
        && d.updatedAt == request.time;
    }

    // Inhaltsseiten (Einführung, Impressum, …): Markdown, bearbeitet in der Verwaltungsseite.
    match /artists/{kuenstler}/seiten/{seite} {
      allow read: if darf(kuenstler, "lesen");
      allow create: if darf(kuenstler, "seiten.bearbeiten")
        && seite.matches("^[a-z0-9][a-z0-9-]{0,59}$")
        && gueltigeSeite(request.resource.data);
      allow update: if darf(kuenstler, "seiten.bearbeiten") && gueltigeSeite(request.resource.data);
      allow delete: if darf(kuenstler, "seiten.bearbeiten");
    }

    match /artists/{kuenstler}/works/{werk} {
      allow read: if darf(kuenstler, "lesen");

      // Nur bearbeiten (kein Anlegen/Löschen). Inv. Nr. und Werkgruppe bleiben,
      // der Zeitstempel ist der des Servers, und derselbe Schreibvorgang muss den
      // Verlaufseintrag anlegen, auf den `lastChange` zeigt — keine Änderung
      // bleibt unprotokolliert.
      allow update: if darf(kuenstler, "werke.bearbeiten")
        && request.resource.data.InvNr == resource.data.InvNr
        && request.resource.data.werkgruppe == resource.data.werkgruppe
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/artists/$(kuenstler)/history/$(request.resource.data.lastChange)).data.work == werk
        && !exists(/databases/$(database)/documents/artists/$(kuenstler)/history/$(request.resource.data.lastChange));
    }

    // Veröffentlichen: Wer darf, fordert einen neuen Build der Seite an; die
    // Funktion `veroeffentlichen` (gcf/publish.js) startet Cloud Build und trägt
    // den Rest ein.
    match /artists/{kuenstler}/veroeffentlichungen/{v} {
      allow read: if darf(kuenstler, "lesen");
      allow create: if darf(kuenstler, "veroeffentlichen")
        && request.resource.data.keys().hasOnly(["von", "angefordert", "status"])
        && request.resource.data.von == emailAdresse()
        && request.resource.data.angefordert == request.time
        && request.resource.data.status == "angefordert";
    }

    // Änderungsprotokoll, nur anfügen: wer, wann, welches Werk. Nie bearbeitet oder gelöscht.
    match /artists/{kuenstler}/history/{eintrag} {
      allow read: if darf(kuenstler, "lesen");
      allow create: if darf(kuenstler, "werke.bearbeiten")
        && request.resource.data.by == emailAdresse()
        && request.resource.data.at == request.time
        && request.resource.data.work is string
        && request.resource.data.changes is map;
    }
  }
}
